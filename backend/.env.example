# Environment Configuration for Intent Runtime Backend
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development  # Use 'production' for mainnet

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/intent-runtime

# NEAR Configuration
# For testnet: Create account at https://testnet.mynearwallet.com/
# For mainnet: Use a properly secured account

NEAR_ACCOUNT_ID=your-account.testnet
NEAR_PRIVATE_KEY=ed25519:your-private-key-here

# Note: For production, use secure key management (AWS Secrets Manager, Vault, etc.)
# Never commit real private keys to source control
